# Mot de passe de l'espace admin (/admin). Obligatoire en production.
ADMIN_PASSWORD=change-moi
# Clé secrète pour signer la session admin (une longue chaîne au hasard).
SESSION_SECRET=remplace-par-une-longue-chaine-aleatoire
# Adresse publique du site, utilisée dans les messages envoyés.
SITE_URL=https://exemple.co.il
# Dossier où sont stockées la base et les photos envoyées depuis l'admin.
DATA_DIR=./data

# Facultatif : prévenir la coiffeuse par WhatsApp ou SMS à chaque nouvelle demande (Twilio).
# Sans ces variables, les demandes apparaissent seulement dans l'admin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro d'envoi Twilio. Pour WhatsApp : whatsapp:+14155238886 ; pour SMS : +1...
TWILIO_FROM=
# Numéro de la coiffeuse qui reçoit les alertes, format international : +9725XXXXXXXX
OWNER_PHONE=
